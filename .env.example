# This file contains placeholders only. Copy to .env and choose your own values.
# .env and runtime state are excluded from Git.
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Optional directory for credentials, registered machines and uploaded images.
# WEB_STATE_DIR=/absolute/path/to/private-state
# CODEX_DEFAULT_CWD=/absolute/path/to/your/projects

# auto: Linux/macOS shared daemon, Windows stdio. shared / stdio also supported.
CODEX_TRANSPORT=auto
# CODEX_HOME=/absolute/path/to/your/codex-home
# CODEX_SOCKET=/absolute/path/to/app-server-control.sock

# Optional custom launcher/proxy; JSON is parsed as arguments, never as shell code.
# CODEX_COMMAND_JSON='["/path/to/launcher","run","/path/to/codex"]'
# Or use CODEX_PROXY_BIN with CODEX_BIN:
# CODEX_PROXY_BIN=/path/to/launcher
# CODEX_BIN=/path/to/codex

# Set your exact HTTPS origin before accessing through a public reverse proxy.
# WEB_PUBLIC_ORIGIN=https://your-domain.ngrok-free.app
# Leave empty for a dedicated site; set /codex when using the optional gateway.
WEB_PUBLIC_PATH=
# WEB_ALLOWED_HOSTS=console.example.com

# Optional shared-domain gateway; not needed for a dedicated ngrok endpoint.
# GATEWAY_PUBLIC_ORIGIN=https://your-domain.ngrok-free.app
# GATEWAY_MAIN_URL=http://127.0.0.1:3000
# GATEWAY_CODEX_URL=http://127.0.0.1:8787
# GATEWAY_PORT=8790
