[Unit]
Description=Codex Remote Console connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/codex-connector
ExecStart=/usr/bin/node %h/codex-connector/agent-connect.mjs
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
